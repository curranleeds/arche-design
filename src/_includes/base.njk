<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if page.url == "/" %}{{ site.name }}{% else %}{{ title }} · {{ site.name }}{% endif %}</title>
    {#- Remove this line when the site is ready to be found by search engines. -#}
    <meta name="robots" content="noindex" />
    <meta name="description" content="{{ description or 'Documentation for the Arche Design System: the tokens, type, color and components behind my personal brand.' }}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title or site.name }}" />
    <meta property="og:description" content="{{ description or 'Tokens, type, color and components, documented from the source files.' }}" />
    <script>
      // Runs before first paint: apply a saved Light or Dark choice so the page never flashes. A color mode is never saved: every page starts in Canon.
      (function () {
        document.documentElement.classList.add('js');
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') document.documentElement.setAttribute('data-theme', saved);
        } catch (e) {}
      })();
    </script>
    <link rel="stylesheet" href="/css/fonts.css" />
    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/case-study.css" />
    <link rel="stylesheet" href="/css/docs.css" />
    <script src="/assets/js/theme.js" defer></script>
    <script src="/assets/js/docs.js" defer></script>
    <script src="/assets/js/mode.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    {% from "components.njk" import button, textLink %}
    {% set info = page.url | pageInfo %}
    <header class="docs-header">
      <a class="docs-header__name type-h3" href="/">{{ site.name }}</a>
      <p class="docs-header__page">
        <span class="docs-header__section type-small">{% if info %}{{ info.section }}{% else %}{{ eyebrow or site.short }}{% endif %}</span>
        <span class="docs-header__title type-h3">{% if info %}{{ info.item.title }}{% else %}{{ title }}{% endif %}</span>
      </p>
      <div class="docs-header__tools">
        <a class="link docs-header__portfolio" href="{{ site.portfolio }}"><span class="link__text">curranleeds.com</span></a>
        <div class="docs-header__theme">{% include "theme-toggle.njk" %}</div>
        {{ button("Menu", type="secondary", icon="expand_more", iconPosition="trailing", extraClass="docs-menu-button", attrs='aria-expanded="false" aria-controls="docs-menu" data-menu-button') }}
      </div>
    </header>
    <div class="docs-dim" data-menu-dim></div>
    <section class="docs-hero" aria-labelledby="page-title">
      <div class="docs-hero__text">
        <div class="docs-hero__heading">
          {% if eyebrow %}<p class="docs-hero__eyebrow type-label">{{ eyebrow }}</p>{% endif %}
          <h1 class="docs-hero__title type-h1" id="page-title" tabindex="-1">{{ title }}</h1>
        </div>
        {% if lead %}<p class="docs-hero__lead type-lead">{{ lead }}</p>{% endif %}
      </div>
    </section>
    <div class="docs-shell">
      <nav class="docs-nav" id="docs-menu" aria-label="Design system" data-menu>
        {% if info %}<p class="docs-nav__count type-label">Page {{ info.index }} of {{ info.total }}</p>{% endif %}
        {% for group in nav %}
        <div class="docs-nav__group">
          <p class="docs-nav__heading type-label">{{ group.title }}</p>
          <ul class="docs-nav__list" role="list">
            {% for item in group.items %}
            <li><a class="docs-nav__link type-body" href="{{ item.url }}" data-focus-h1{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </nav>
      <main class="docs-main" id="main">
        <div class="docs-content">
          {{ content | safe }}
        </div>
        {% if info %}
        <section class="docs-next" aria-labelledby="next-h">
          <div class="docs-next__text">
            {% if info.next %}
            <p class="docs-next__kicker type-label">Up next</p>
            <h2 class="docs-next__title type-h2" id="next-h">{{ info.next.title }}</h2>
            <p class="docs-next__desc type-lead">{{ info.next.description }}</p>
            {% else %}
            <p class="docs-next__kicker type-label">The end</p>
            <h2 class="docs-next__title type-h2" id="next-h">You've reached the end</h2>
            <p class="docs-next__desc type-lead">That is every page in the system.</p>
            {% endif %}
          </div>
          <div class="docs-next__actions">
            {% if info.next %}
            {{ button("Continue to " + info.next.title, type="primary", href=info.next.url, icon="arrow_forward", iconPosition="trailing", onBrand=true, attrs="data-focus-h1") }}
            {% else %}
            {{ button("Back to Overview", type="primary", href="/", icon="arrow_back", iconPosition="leading", onBrand=true, attrs="data-focus-h1") }}
            {% endif %}
            {% if info.prev %}<p class="docs-next__back"><a class="link link--on-brand" href="{{ info.prev.url }}" data-focus-h1><span class="link__text">Back to {{ info.prev.title }}</span></a></p>{% endif %}
          </div>
        </section>
        {% endif %}
        <footer class="docs-footer type-small">
          <div class="docs-footer__theme">{% include "theme-toggle.njk" %}</div>
          <p>{{ site.name }} v{{ site.version }}, {{ site.updated }}. Tokens are read from the source file at build time. Built by <a class="link" href="{{ site.portfolio }}"><span class="link__text">{{ site.author }}</span></a>.</p>
        </footer>
      </main>
    </div>
  </body>
</html>
