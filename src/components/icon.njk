      <thead><tr><th scope="col">Icon</th><th scope="col">Name</th><th scope="col">Where it is used</th></tr></thead>
      <tbody>
        <tr><td>{% icon "arrow_back" %}</td><th scope="row"><code>arrow_back</code></th><td>Leading icon on a back button, such as "All work" on a case study hero.</td></tr>
        <tr><td>{% icon "arrow_forward" %}</td><th scope="row"><code>arrow_forward</code></th><td>The arrow on a list row, and the trailing icon on a "next" button.</td></tr>
        <tr><td>{% icon "close" %}</td><th scope="row"><code>close</code></th><td>Close buttons, in the menu overlay and the image viewer.</td></tr>
        <tr><td>{% icon "dark_mode" %}</td><th scope="row"><code>dark_mode</code></th><td>The theme toggle in light mode, naming the mode it switches to.</td></tr>
        <tr><td>{% icon "light_mode" %}</td><th scope="row"><code>light_mode</code></th><td>The theme toggle in dark mode.</td></tr>
