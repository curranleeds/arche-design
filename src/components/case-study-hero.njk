        </div>
        <div class="cs-hero__lede">
          <p class="cs-hero__subtitle type-lead">One or two sentences that say what the project was and what changed.</p>
          <div class="cs-hero__actions">
            {{ button("Link label", type="secondary", onBrand=true, href="#", icon="open_in_new", iconPosition="trailing", external=true) }}
          </div>
        </div>
