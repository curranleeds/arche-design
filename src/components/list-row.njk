            <span class="cs-row-link__category type-label">Category</span>
          </span>
          <span class="cs-row-link__arrow" aria-hidden="true">{% icon "arrow_forward" %}</span>
        </a>
      </li>
      <li>
        <a class="cs-row-link" href="#">
          <span class="cs-row-link__text">
            <span class="cs-row-link__title type-h3">Another case study title</span>
            <span class="cs-row-link__category type-label">Category</span>
          </span>
          <span class="cs-row-link__arrow" aria-hidden="true">{% icon "arrow_forward" %}</span>
