<section aria-labelledby="demo-h">
  <h2 id="demo-h" class="type-h2">Section split</h2>
  <p>The section split is the basic block of a case study page. The left side has the section name, which is the <code>h2</code>, and a one-sentence statement. The right side has the body text. The split is never an even 50/50. The text below is placeholder text.</p>
  {% demo "Section split on the plain surface, with placeholder text", "block" %}
  <section class="cs-split" aria-labelledby="split-demo-h">
    <div class="cs-row">
      <div class="cs-split__label">
        <h3 class="cs-split__name type-subhead" id="split-demo-h">Section name</h3>
        <p class="cs-split__statement type-h2">One sentence that states the point of this section.</p>
      </div>
      <div class="cs-copy type-body">
        <p>Body text goes here. Each paragraph sits 16px below the one before it.</p>
        <p>A second paragraph, to show the spacing.</p>
      </div>
    </div>
  </section>
  {% enddemo %}
  {% demo "Section split on the blue tint", "block" %}
  <section class="cs-split cs-split--tint" aria-labelledby="split-tint-h">
    <div class="cs-row">
      <div class="cs-split__label">
        <h3 class="cs-split__name type-subhead" id="split-tint-h">Section name</h3>
        <p class="cs-split__statement type-h2">One sentence that states the point of this section.</p>
      </div>
      <div class="cs-copy type-body">
