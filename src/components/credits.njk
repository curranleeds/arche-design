<section aria-labelledby="layout-h">
  <h2 id="layout-h" class="type-h2">Layout and spacing</h2>
  <div class="table-wrap" tabindex="0" role="region" aria-label="Credits spacing by breakpoint, scrollable">
    <table class="docs-table type-small">
      <thead><tr><th scope="col">Breakpoint</th><th scope="col">Padding above and below</th><th scope="col">Gap between heading and list</th></tr></thead>
