<section aria-labelledby="demo-h">
  <h2 id="demo-h" class="type-h2">Stat strip</h2>
  <p>The numbers use the Stat style in dark brand blue, on the blue tint, with a 2px rule above. On desktop the stats sit in one row, on tablet in a 2 by 2 grid, and on mobile one per row with the number on the left. The values below are placeholders, not real results.</p>
  {% demo "Stat strip with placeholder values", "block" %}
  <section class="cs-stats" aria-labelledby="impact-demo-h">
    <div class="cs-stats__inner">
      <h3 class="cs-stats__heading type-label" id="impact-demo-h">Impact</h3>
      <dl class="cs-stats__list">
        <div class="cs-stat"><dt class="cs-stat__label type-body">Example label for the first stat</dt><dd class="cs-stat__number type-stat">00</dd></div>
        <div class="cs-stat"><dt class="cs-stat__label type-body">Example label for the second stat</dt><dd class="cs-stat__number type-stat">00%</dd></div>
        <div class="cs-stat"><dt class="cs-stat__label type-body">Example label for the third stat</dt><dd class="cs-stat__number type-stat">0</dd></div>
