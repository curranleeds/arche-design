{
  "name": "arche-design",
  "version": "0.9.1",
  "description": "Documentation site for the Arche Design System: tokens, type, color, and core components.",
  "private": false,
  "scripts": {
    "start": "eleventy --serve",
    "check": "node scripts/check-vars.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:nav": "node scripts/check-nav.mjs",
    "check:a11y": "eleventy && node scripts/check-a11y.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "build": "npm run tokens && npm run manifest && npm run check && npm run check:contrast && eleventy && npm run check:nav",
    "tokens": "node scripts/generate-tokens.mjs --prefix arche",
    "sync": "node scripts/sync-from-portfolio.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@axe-core/playwright": "^4.14.0",
    "playwright": "^1.64.1"
  }
}
